<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IM Store</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Jost:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#F4E9DC;
    --cream-deep:#EBDAC5;
    --card:#FBF5EC;
    --ink:#221C16;
    --taupe:#5B4A3B;
    --taupe-light:#8A7563;
    --gold:#AD8A54;
    --white:#FFFDFB;
    --line:#DBC9AF;
    --shadow:0 10px 30px rgba(34,28,22,0.08);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--cream);
    color:var(--ink);
    font-family:'Jost', sans-serif;
    line-height:1.7;
    min-height:100vh;
  }
  h1,h2,h3{ font-family:'Cormorant Garamond', serif; font-weight:700; }
  img{max-width:100%; display:block;}
  button{font-family:inherit; cursor:pointer; border:none;}
  input, textarea, select{font-family:inherit;}

  /* ---------- Top bar ---------- */
  .topbar{
    position:sticky; top:0; z-index:40;
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 22px;
    background:rgba(244,233,220,0.9);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  .brand-mini{display:flex; align-items:center; gap:10px;}
  .brand-mini svg{width:34px; height:34px;}
  .brand-mini span{font-family:'Cormorant Garamond', serif; font-weight:700; font-size:1.15rem; letter-spacing:1px;}
  .top-actions{display:flex; gap:10px;}
  .icon-btn{
    background:var(--card); border:1px solid var(--line); border-radius:999px;
    width:40px; height:40px; display:flex; align-items:center; justify-content:center;
    color:var(--taupe); transition:.2s;
  }
  .icon-btn:hover{background:var(--taupe); color:var(--white);}

  /* ---------- Hero ---------- */
  .hero{
    position:relative; text-align:center; padding:64px 20px 46px;
    overflow:hidden;
  }
  .hero::before{
    content:"";
    position:absolute; inset:0;
    background: radial-gradient(circle at 50% 0%, var(--cream-deep), transparent 60%);
    z-index:0;
  }
  .hero-inner{position:relative; z-index:1;}
  .logo-mark{width:150px; height:150px; margin:0 auto 6px;}
  .store-name{
    font-family:'Cormorant Garamond', serif; font-weight:700;
    font-size:2.8rem; color:var(--taupe); letter-spacing:3px;
  }
  .tagline{
    font-size:1rem; color:var(--taupe-light); margin-top:10px;
    font-weight:400; letter-spacing:.5px;
  }
  .divider-leaf{width:120px; margin:22px auto;}
  .hero-cta{
    margin-top:8px; display:inline-block; padding:13px 34px;
    background:var(--taupe); color:var(--white); border-radius:999px;
    font-weight:600; letter-spacing:1px; font-size:.9rem; text-transform:uppercase;
    box-shadow:var(--shadow); transition:.2s;
  }
  .hero-cta:hover{background:var(--ink);}

  /* ---------- Category bar ---------- */
  .filters-wrap{
    position:sticky; top:64px; z-index:30;
    background:var(--cream); padding:14px 0 16px;
    border-bottom:1px solid var(--line);
  }
  .filters{
    display:flex; gap:10px; overflow-x:auto; padding:0 20px;
    scrollbar-width:none;
  }
  .filters::-webkit-scrollbar{display:none;}
  .chip{
    flex:0 0 auto; padding:9px 20px; border-radius:999px;
    background:var(--card); border:1px solid var(--line);
    font-size:.85rem; font-weight:500; color:var(--taupe);
    white-space:nowrap; transition:.2s;
  }
  .chip.active, .chip:hover{background:var(--taupe); color:var(--white); border-color:var(--taupe);}
  .search-row{max-width:1100px; margin:16px auto 0; padding:0 20px;}
  .search-input{
    width:100%; padding:12px 18px; border-radius:12px;
    border:1px solid var(--line); background:var(--card);
    font-size:.95rem; color:var(--ink);
  }
  .search-input:focus{outline:2px solid var(--gold);}

  /* ---------- Products ---------- */
  .section-title{
    text-align:center; font-size:1.7rem; color:var(--ink);
    margin:44px 0 26px; letter-spacing:.5px;
  }
  .grid{
    display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr));
    gap:22px; max-width:1200px; margin:0 auto; padding:0 20px 60px;
  }
  .card{
    background:var(--card); border-radius:16px; overflow:hidden;
    border:1px solid var(--line); box-shadow:var(--shadow);
    display:flex; flex-direction:column; transition:transform .25s;
  }
  .card:hover{transform:translateY(-4px);}
  .card-img{
    position:relative;
    width:100%; aspect-ratio:3/4; background:var(--cream-deep);
    display:flex; align-items:center; justify-content:center;
    overflow:hidden; color:var(--taupe-light); font-size:.85rem;
  }
  .card-img img{width:100%; height:100%; object-fit:cover; display:block; opacity:0; position:absolute; inset:0; transition:opacity .6s ease;}
  .card-img img.active-slide{opacity:1; position:relative;}
  .card-img-nav{
    position:absolute; top:50%; transform:translateY(-50%);
    width:28px; height:28px; border-radius:50%; background:rgba(34,28,22,.45);
    color:#fff; display:flex; align-items:center; justify-content:center;
    font-size:.9rem; opacity:0; transition:.2s;
  }
  .card-img:hover .card-img-nav{opacity:1;}
  .card-img-nav.prev{left:8px;}
  .card-img-nav.next{right:8px;}
  .card-img-dots{
    position:absolute; bottom:8px; left:50%; transform:translateX(-50%);
    display:flex; gap:5px;
  }
  .card-img-dots span{
    width:6px; height:6px; border-radius:50%; background:rgba(255,255,255,.6);
  }
  .card-img-dots span.active{background:#fff;}
  .card-body{padding:16px; display:flex; flex-direction:column; gap:8px; flex:1;}
  .card-cat{font-size:.72rem; color:var(--gold); font-weight:600; letter-spacing:1px; text-transform:uppercase;}
  .card-name{font-family:'Cormorant Garamond', serif; font-weight:700; font-size:1.2rem; color:var(--ink);}
  .card-desc{font-size:.85rem; color:var(--taupe-light); flex:1;}
  .card-price{font-family:'Cormorant Garamond', serif; font-weight:700; color:var(--taupe); font-size:1.25rem;}
  .order-btn{
    margin-top:4px; padding:10px; border-radius:10px; background:#25D366;
    color:#fff; font-weight:600; font-size:.85rem; display:flex;
    align-items:center; justify-content:center; gap:8px;
  }
  .order-btn:hover{background:#1eb857;}
  .mini-btn{
    border-radius:10px; background:var(--taupe); color:#fff; font-weight:600; font-size:.85rem;
  }
  .mini-btn:hover{background:var(--ink);}

  .empty-state{
    text-align:center; padding:60px 20px; color:var(--taupe-light);
    max-width:420px; margin:0 auto;
  }
  .empty-state h3{color:var(--taupe); margin-bottom:10px; font-size:1.4rem;}
  .empty-state button{
    margin-top:18px; padding:12px 26px; background:var(--taupe); color:#fff;
    border-radius:999px; font-weight:600;
  }

  /* ---------- Footer ---------- */
  footer{
    background:var(--ink); color:var(--cream-deep); text-align:center;
    padding:40px 20px 30px; margin-top:20px;
  }
  footer .logo-mark{width:60px; height:60px; margin-bottom:14px; filter:brightness(1.4);}
  footer p{font-size:.82rem; opacity:.75; letter-spacing:.5px;}

  .float-wa{
    position:fixed; bottom:22px; right:22px; z-index:50;
    width:56px; height:56px; border-radius:50%; background:#25D366;
    display:flex; align-items:center; justify-content:center; box-shadow:0 8px 20px rgba(0,0,0,.25);
  }
  .float-wa svg{width:28px; height:28px; fill:#fff;}

  /* ---------- Modals ---------- */
  .overlay{
    position:fixed; inset:0; background:rgba(34,28,22,.55); z-index:100;
    display:none; align-items:flex-end; justify-content:center;
  }
  .overlay.show{display:flex;}
  .panel{
    background:var(--cream); width:100%; max-width:560px; max-height:88vh;
    overflow-y:auto; border-radius:22px 22px 0 0; padding:26px 24px 34px;
    animation:slideUp .25s ease-out;
  }
  @media(min-width:640px){
    .overlay{align-items:center;}
    .panel{border-radius:20px; max-height:82vh;}
  }
  @keyframes slideUp{from{transform:translateY(40px); opacity:0;} to{transform:translateY(0); opacity:1;}}
  .panel-head{display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;}
  .panel-head h2{font-size:1.4rem; color:var(--taupe);}
  .close-x{width:34px; height:34px; border-radius:50%; background:var(--card); border:1px solid var(--line); color:var(--taupe); font-size:1.1rem;}

  .field{margin-bottom:16px;}
  .field label{display:block; font-size:.8rem; font-weight:600; color:var(--taupe); margin-bottom:6px; letter-spacing:.3px;}
  .field input, .field textarea, .field select{
    width:100%; padding:11px 14px; border-radius:10px; border:1px solid var(--line);
    background:var(--white); font-size:.92rem; color:var(--ink);
  }
  .field textarea{resize:vertical; min-height:70px;}
  .field-row{display:flex; gap:12px;}
  .field-row > div{flex:1;}
  .upload-row{display:flex; gap:10px; margin-bottom:10px; flex-wrap:wrap;}
  .upload-slot{
    width:100px; aspect-ratio:3/4; border-radius:12px; overflow:hidden; position:relative;
    background:var(--card); border:1px dashed var(--line); display:flex; align-items:center;
    justify-content:center; color:var(--taupe-light); font-size:.72rem; text-align:center;
  }
  .upload-slot img{width:100%; height:100%; object-fit:cover;}
  .upload-slot .slot-remove{
    position:absolute; top:4px; right:4px; width:20px; height:20px; border-radius:50%;
    background:rgba(34,28,22,.6); color:#fff; font-size:.7rem; display:flex;
    align-items:center; justify-content:center;
  }
  .upload-slot.add-slot{cursor:pointer;}
  .upload-slot.add-slot:hover{background:var(--cream-deep);}
  .save-btn{
    width:100%; padding:14px; background:var(--taupe); color:#fff; border-radius:12px;
    font-weight:600; font-size:.95rem; margin-top:6px; letter-spacing:.5px; text-transform:uppercase;
  }
  .save-btn:hover{background:var(--ink);}
  .divider-thin{height:1px; background:var(--line); margin:22px 0;}
  .existing-item{
    display:flex; gap:12px; align-items:center; padding:10px; border-radius:12px;
    background:var(--card); border:1px solid var(--line); margin-bottom:10px;
  }
  .existing-item img{width:52px; height:64px; object-fit:cover; border-radius:8px; background:var(--cream-deep);}
  .existing-item .ei-info{flex:1;}
  .existing-item .ei-name{font-weight:600; font-size:.92rem;}
  .existing-item .ei-price{font-size:.8rem; color:var(--taupe-light);}
  .existing-item .ei-actions{display:flex; gap:6px;}
  .existing-item .ei-actions button{
    width:32px; height:32px; border-radius:8px; background:var(--white); border:1px solid var(--line);
  }
  .hint{font-size:.76rem; color:var(--taupe-light); margin-top:4px;}
  .order-item{
    padding:14px; border-radius:12px; background:var(--card); border:1px solid var(--line);
    margin-bottom:12px;
  }
  .order-item-top{display:flex; justify-content:space-between; align-items:flex-start; gap:8px;}
  .order-item .oi-product{font-family:'Cormorant Garamond', serif; font-weight:700; font-size:1.1rem; color:var(--ink);}
  .order-item .oi-price{color:var(--taupe); font-weight:600; font-size:.9rem;}
  .order-item .oi-meta{font-size:.82rem; color:var(--taupe-light); margin-top:6px; line-height:1.6;}
  .order-item .oi-actions{display:flex; gap:8px; margin-top:10px;}
  .order-item select{
    flex:1; padding:8px 10px; border-radius:8px; border:1px solid var(--line);
    background:var(--white); font-size:.82rem;
  }
  .order-item .oi-del{
    width:36px; height:36px; border-radius:8px; background:var(--white); border:1px solid var(--line);
  }
  .status-badge{
    display:inline-block; padding:2px 10px; border-radius:999px; font-size:.72rem; font-weight:600;
  }
  .status-new{background:#fbe8c8; color:#8a5a1a;}
  .status-confirmed{background:#dcecd8; color:#3c6b34;}
  .status-done{background:#dcdcdc; color:#555;}
  .toast{
    position:fixed; bottom:26px; left:50%; transform:translateX(-50%);
    background:var(--ink); color:#fff; padding:12px 22px; border-radius:999px;
    font-size:.86rem; z-index:200; opacity:0; pointer-events:none; transition:.3s;
  }
  .toast.show{opacity:1; transform:translate(-50%,-6px);}
  .loading-msg{text-align:center; padding:40px; color:var(--taupe-light);}
</style>
</head>
<body>

<div class="topbar">
  <div class="brand-mini">
    <svg viewBox="0 0 100 100"><use href="#logoSymbol"/></svg>
    <span id="brandNameMini">IMANI STORE</span>
  </div>
  <div class="top-actions">
    <button class="icon-btn" id="btnOrders" title="Orders">📦</button>
    <button class="icon-btn" id="btnSettings" title="Settings">⚙</button>
    <button class="icon-btn" id="btnManage" title="Manage products">✎</button>
  </div>
</div>

<!-- Hero -->
<section class="hero">
  <div class="hero-inner">
    <svg class="logo-mark" viewBox="0 0 220 220"><use href="#logoSymbol"/></svg>
    <div class="store-name" id="storeName">IMANI STORE</div>
    <div class="tagline" id="storeTagline">Style, chosen with care</div>
    <svg class="divider-leaf" viewBox="0 0 200 30">
      <path d="M10 15 H190" stroke="#AD8A54" stroke-width="1"/>
      <g fill="#AD8A54">
        <ellipse cx="60" cy="15" rx="7" ry="3" transform="rotate(-25 60 15)"/>
        <ellipse cx="80" cy="15" rx="8" ry="3.2" transform="rotate(-15 80 15)"/>
        <ellipse cx="140" cy="15" rx="8" ry="3.2" transform="rotate(15 140 15)"/>
        <ellipse cx="160" cy="15" rx="7" ry="3" transform="rotate(25 160 15)"/>
      </g>
      <circle cx="100" cy="15" r="3" fill="#AD8A54"/>
    </svg>
    <a href="#products" class="hero-cta">Shop Now</a>
  </div>
</section>

<!-- Filters -->
<div class="filters-wrap">
  <div class="filters" id="filters"></div>
  <div class="search-row">
    <input type="text" class="search-input" id="searchInput" placeholder="Search for an item… (e.g. shirt, dress)">
  </div>
</div>

<h2 class="section-title" id="products">Our Collection</h2>
<div class="grid" id="productGrid">
  <div class="loading-msg">Loading…</div>
</div>

<footer>
  <svg class="logo-mark" viewBox="0 0 220 220"><use href="#logoSymbol"/></svg>
  <p id="footerText">© 2026 IM Store — All rights reserved</p>
</footer>

<a class="float-wa" id="floatWa" href="#" target="_blank" title="Message us on WhatsApp">
  <svg viewBox="0 0 32 32"><path d="M16.03 3C9.4 3 4 8.4 4 15.03c0 2.35.63 4.55 1.72 6.44L4 29l7.7-1.66a11.9 11.9 0 0 0 4.33.8h.01c6.63 0 12.03-5.4 12.03-12.03C28.06 8.4 22.66 3 16.03 3zm0 21.9c-1.55 0-3.06-.4-4.38-1.16l-.31-.18-4.57.98.99-4.46-.2-.32a9.85 9.85 0 0 1-1.5-5.25c0-5.47 4.46-9.9 9.97-9.9 5.47 0 9.9 4.44 9.9 9.9 0 5.47-4.44 9.9-9.9 9.9zm5.44-7.42c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.09 3.2 5.07 4.48.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35z"/></svg>
</a>

<!-- Settings Modal -->
<div class="overlay" id="settingsOverlay">
  <div class="panel">
    <div class="panel-head">
      <h2>Store Settings</h2>
      <button class="close-x" data-close="settingsOverlay">✕</button>
    </div>
    <div class="field">
      <label>Store name</label>
      <input type="text" id="setName" placeholder="IM">
    </div>
    <div class="field">
      <label>Tagline (shown under the name)</label>
      <input type="text" id="setTagline" placeholder="Style, chosen with care">
    </div>
    <div class="field">
      <label>WhatsApp number (international format, no + or 00, e.g. 12125551234)</label>
      <input type="text" id="setWhatsapp" placeholder="12125551234">
    </div>
    <div class="field">
      <label>Currency symbol</label>
      <input type="text" id="setCurrency" placeholder="$">
    </div>
    <button class="save-btn" id="saveSettings">Save Settings</button>
    <p class="hint">These settings are saved automatically and shown to every visitor of your store.</p>
  </div>
</div>

<!-- Manage Products Modal -->
<div class="overlay" id="manageOverlay">
  <div class="panel">
    <div class="panel-head">
      <h2>Add a New Product</h2>
      <button class="close-x" data-close="manageOverlay">✕</button>
    </div>

    <div class="field">
      <label>Product photos (up to 3)</label>
      <div class="upload-row" id="uploadRow"></div>
      <input type="file" id="imgInput" accept="image/*" multiple style="display:none">
      <p class="hint">…or paste an image link instead of uploading:</p>
      <div style="display:flex; gap:8px;">
        <input type="text" id="imgUrlInput" placeholder="https://...">
        <button type="button" id="addUrlBtn" class="mini-btn" style="flex:0 0 auto; padding:0 16px;">Add</button>
      </div>
    </div>

    <div class="field">
      <label>Item name</label>
      <input type="text" id="pName" placeholder="e.g. Striped Summer Dress">
    </div>

    <div class="field-row">
      <div class="field">
        <label>Price</label>
        <input type="number" id="pPrice" placeholder="45">
      </div>
      <div class="field">
        <label>Category</label>
        <input type="text" id="pCategory" list="catList" placeholder="Dresses">
        <datalist id="catList"></datalist>
      </div>
    </div>

    <div class="field">
      <label>Short description (optional)</label>
      <textarea id="pDesc" placeholder="Size, fabric, color..."></textarea>
    </div>

    <button class="save-btn" id="saveProduct">Add Product</button>

    <div class="divider-thin"></div>
    <h2 style="font-size:1.15rem; color:var(--taupe); margin-bottom:12px;">Current Products</h2>
    <div id="existingList"></div>
  </div>
</div>

<!-- Order capture modal (customer-facing) -->
<div class="overlay" id="orderOverlay">
  <div class="panel">
    <div class="panel-head">
      <h2>Complete Your Order</h2>
      <button class="close-x" data-close="orderOverlay">✕</button>
    </div>
    <div class="field">
      <label>Item</label>
      <div class="hint" id="orderItemLabel" style="font-size:.95rem; color:var(--ink);"></div>
    </div>
    <div class="field">
      <label>Your name</label>
      <input type="text" id="custName" placeholder="Full name">
    </div>
    <div class="field">
      <label>Your phone number</label>
      <input type="text" id="custPhone" placeholder="e.g. 12125551234">
    </div>
    <div class="field">
      <label>Delivery address (optional)</label>
      <textarea id="custAddress" placeholder="Street, city..."></textarea>
    </div>
    <button class="save-btn" id="confirmOrderBtn">Confirm & Send on WhatsApp</button>
    <p class="hint">Your order is recorded, then WhatsApp opens so you can confirm details with us directly.</p>
  </div>
</div>

<!-- Orders admin modal -->
<div class="overlay" id="ordersOverlay">
  <div class="panel">
    <div class="panel-head">
      <h2>Orders</h2>
      <button class="close-x" data-close="ordersOverlay">✕</button>
    </div>
    <div id="ordersList"></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<!-- Shared logo symbol -->
<svg width="0" height="0" style="position:absolute">
  <symbol id="logoSymbol" viewBox="0 0 220 220">
    <path d="M110 40 L115 55 L130 60 L115 65 L110 80 L105 65 L90 60 L105 55 Z" fill="#5B4A3B"/>
    <g stroke="#5B4A3B" stroke-width="2.2" fill="none" stroke-linecap="round">
      <path d="M65 150 C60 130 62 108 78 92"/>
      <path d="M68 140 C60 138 53 133 49 125"/>
      <path d="M63 122 C55 122 47 119 42 112"/>
      <path d="M60 105 C52 107 44 105 38 99"/>
      <path d="M60 90 C53 93 45 92 40 87"/>
    </g>
    <text x="72" y="150" font-family="Cormorant Garamond, serif" font-size="90" font-weight="700" fill="#5B4A3B" text-anchor="middle">I</text>
    <text x="140" y="150" font-family="Cormorant Garamond, serif" font-size="90" font-weight="700" fill="#5B4A3B" text-anchor="middle">M</text>
  </symbol>
</svg>

<script>
const PRODUCTS_KEY = 'im-boutique-products';
const SETTINGS_KEY = 'im-boutique-settings';
const ORDERS_KEY = 'im-boutique-orders';

let products = [];
let orders = [];
let currentOrderProduct = null;
let settings = { name:'IMANI STORE', tagline:'Style, chosen with care', whatsapp:'12125551234', currency:'$' };
let activeCategory = 'All';
let searchTerm = '';

function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), 2200);
}

function openModal(id){ document.getElementById(id).classList.add('show'); }
function closeModal(id){ document.getElementById(id).classList.remove('show'); }
document.querySelectorAll('[data-close]').forEach(b=>{
  b.addEventListener('click', ()=>closeModal(b.dataset.close));
});
document.querySelectorAll('.overlay').forEach(o=>{
  o.addEventListener('click', (e)=>{ if(e.target === o) o.classList.remove('show'); });
});

document.getElementById('btnOrders').addEventListener('click', async ()=>{
  await loadOrders();
  renderOrdersList();
  openModal('ordersOverlay');
});

document.getElementById('btnSettings').addEventListener('click', ()=>{
  document.getElementById('setName').value = settings.name;
  document.getElementById('setTagline').value = settings.tagline;
  document.getElementById('setWhatsapp').value = settings.whatsapp;
  document.getElementById('setCurrency').value = settings.currency;
  openModal('settingsOverlay');
});
document.getElementById('btnManage').addEventListener('click', ()=>{
  pendingImages = [];
  renderUploadRow();
  renderExistingList();
  renderCategoryDatalist();
  openModal('manageOverlay');
});

async function loadSettings(){
  try{
    const res = await window.storage.get(SETTINGS_KEY, true);
    if(res && res.value){ settings = JSON.parse(res.value); }
  }catch(e){ /* not set yet, use defaults */ }
  applySettings();
}

function applySettings(){
  document.getElementById('brandNameMini').textContent = settings.name;
  document.getElementById('storeName').textContent = settings.name;
  document.getElementById('storeTagline').textContent = settings.tagline;
  document.getElementById('footerText').textContent = `© 2026 ${settings.name} Store — All rights reserved`;
  document.title = `${settings.name} Store`;
  document.getElementById('floatWa').href = `https://wa.me/${settings.whatsapp}`;
}

document.getElementById('saveSettings').addEventListener('click', async ()=>{
  settings = {
    name: document.getElementById('setName').value.trim() || 'IM',
    tagline: document.getElementById('setTagline').value.trim(),
    whatsapp: document.getElementById('setWhatsapp').value.trim().replace(/\D/g,''),
    currency: document.getElementById('setCurrency').value.trim() || '$'
  };
  try{
    await window.storage.set(SETTINGS_KEY, JSON.stringify(settings), true);
    applySettings();
    showToast('Settings saved ✓');
    closeModal('settingsOverlay');
  }catch(e){ showToast('Something went wrong, please try again'); }
});

async function loadProducts(){
  try{
    const res = await window.storage.get(PRODUCTS_KEY, true);
    products = res && res.value ? JSON.parse(res.value) : [];
  }catch(e){
    products = [];
  }
  renderFilters();
  renderProducts();
}

async function saveProducts(){
  try{
    await window.storage.set(PRODUCTS_KEY, JSON.stringify(products), true);
    return true;
  }catch(e){
    showToast('Could not save, check your connection');
    return false;
  }
}

/* ---------- Orders ---------- */
async function loadOrders(){
  try{
    const res = await window.storage.get(ORDERS_KEY, true);
    orders = res && res.value ? JSON.parse(res.value) : [];
  }catch(e){
    orders = [];
  }
}

async function saveOrders(){
  try{
    await window.storage.set(ORDERS_KEY, JSON.stringify(orders), true);
    return true;
  }catch(e){
    showToast('Could not save the order, check your connection');
    return false;
  }
}

function openOrderModal(product){
  currentOrderProduct = product;
  document.getElementById('orderItemLabel').textContent = `${product.name} — ${settings.currency}${product.price}`;
  document.getElementById('custName').value = '';
  document.getElementById('custPhone').value = '';
  document.getElementById('custAddress').value = '';
  openModal('orderOverlay');
}

document.getElementById('confirmOrderBtn').addEventListener('click', async ()=>{
  const custName = document.getElementById('custName').value.trim();
  const custPhone = document.getElementById('custPhone').value.trim();
  const custAddress = document.getElementById('custAddress').value.trim();

  if(!custName || !custPhone){
    showToast('Please enter your name and phone number');
    return;
  }
  if(!currentOrderProduct) return;

  const order = {
    id: 'o_' + Date.now(),
    productName: currentOrderProduct.name,
    price: currentOrderProduct.price,
    currency: settings.currency,
    customerName: custName,
    customerPhone: custPhone,
    customerAddress: custAddress,
    status: 'new',
    createdAt: new Date().toISOString()
  };

  await loadOrders();
  orders.unshift(order);
  const ok = await saveOrders();

  if(ok){
    const waMsg = encodeURIComponent(
      `Hi, I'd like to order: ${order.productName} (${order.currency}${order.price})\nName: ${custName}\nPhone: ${custPhone}${custAddress ? '\nAddress: ' + custAddress : ''}`
    );
    window.open(`https://wa.me/${settings.whatsapp}?text=${waMsg}`, '_blank');
    closeModal('orderOverlay');
    showToast('Order recorded ✓');
  }
});

function renderOrdersList(){
  const wrap = document.getElementById('ordersList');
  wrap.innerHTML = '';
  if(orders.length === 0){
    wrap.innerHTML = '<p class="hint">No orders yet. They will appear here as customers order from your store.</p>';
    return;
  }
  orders.forEach(o=>{
    const date = new Date(o.createdAt);
    const dateStr = date.toLocaleDateString() + ' ' + date.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
    const row = document.createElement('div');
    row.className = 'order-item';
    row.innerHTML = `
      <div class="order-item-top">
        <div>
          <div class="oi-product">${o.productName}</div>
          <div class="oi-price">${o.currency}${o.price}</div>
        </div>
        <span class="status-badge status-${o.status}">${o.status === 'new' ? 'New' : o.status === 'confirmed' ? 'Confirmed' : 'Done'}</span>
      </div>
      <div class="oi-meta">
        ${o.customerName} · ${o.customerPhone}${o.customerAddress ? '<br>' + o.customerAddress : ''}<br>
        ${dateStr}
      </div>
      <div class="oi-actions">
        <select data-status="${o.id}">
          <option value="new" ${o.status==='new'?'selected':''}>New</option>
          <option value="confirmed" ${o.status==='confirmed'?'selected':''}>Confirmed</option>
          <option value="done" ${o.status==='done'?'selected':''}>Done</option>
        </select>
        <button class="oi-del" data-order-del="${o.id}" title="Delete">🗑</button>
      </div>
    `;
    wrap.appendChild(row);
  });

  wrap.querySelectorAll('[data-status]').forEach(sel=>{
    sel.addEventListener('change', async ()=>{
      const ord = orders.find(o=>o.id === sel.dataset.status);
      if(ord){
        ord.status = sel.value;
        await saveOrders();
        renderOrdersList();
      }
    });
  });
  wrap.querySelectorAll('[data-order-del]').forEach(btn=>{
    btn.addEventListener('click', async ()=>{
      orders = orders.filter(o=>o.id !== btn.dataset.orderDel);
      const ok = await saveOrders();
      if(ok) renderOrdersList();
    });
  });
}

function getCategories(){
  const set = new Set(products.map(p=>p.category).filter(Boolean));
  return ['All', ...Array.from(set)];
}

function renderFilters(){
  const wrap = document.getElementById('filters');
  wrap.innerHTML = '';
  getCategories().forEach(cat=>{
    const chip = document.createElement('button');
    chip.className = 'chip' + (cat===activeCategory ? ' active' : '');
    chip.textContent = cat;
    chip.addEventListener('click', ()=>{ activeCategory = cat; renderFilters(); renderProducts(); });
    wrap.appendChild(chip);
  });
}

function renderCategoryDatalist(){
  const dl = document.getElementById('catList');
  dl.innerHTML = '';
  getCategories().filter(c=>c!=='All').forEach(c=>{
    const opt = document.createElement('option');
    opt.value = c;
    dl.appendChild(opt);
  });
}

document.getElementById('searchInput').addEventListener('input', (e)=>{
  searchTerm = e.target.value.trim().toLowerCase();
  renderProducts();
});

function renderProducts(){
  const grid = document.getElementById('productGrid');
  let list = products;
  if(activeCategory !== 'All') list = list.filter(p=>p.category===activeCategory);
  if(searchTerm) list = list.filter(p=> (p.name||'').toLowerCase().includes(searchTerm) || (p.description||'').toLowerCase().includes(searchTerm));

  if(list.length === 0){
    grid.innerHTML = '';
    const empty = document.createElement('div');
    empty.className = 'empty-state';
    empty.style.gridColumn = '1/-1';
    empty.innerHTML = products.length===0
      ? `<h3>No products yet</h3><p>Start by adding your first item using the "Manage products" button up top.</p><button id="emptyAddBtn">Add a product</button>`
      : `<h3>No results</h3><p>Try another category or a different search term.</p>`;
    grid.appendChild(empty);
    const b = document.getElementById('emptyAddBtn');
    if(b) b.addEventListener('click', ()=>document.getElementById('btnManage').click());
    return;
  }

  grid.innerHTML = '';
  list.forEach(p=>{
    const imgs = (p.images && p.images.length) ? p.images : (p.image ? [p.image] : []);
    const card = document.createElement('div');
    card.className = 'card';

    let imgHtml = 'No photo';
    if(imgs.length){
      imgHtml = imgs.map((src,i)=>`<img src="${src}" class="${i===0?'active-slide':''}" alt="${p.name}">`).join('');
      if(imgs.length > 1){
        imgHtml += `
          <div class="card-img-nav prev">‹</div>
          <div class="card-img-nav next">›</div>
          <div class="card-img-dots">${imgs.map((_,i)=>`<span class="${i===0?'active':''}"></span>`).join('')}</div>
        `;
      }
    }

    card.innerHTML = `
      <div class="card-img">${imgHtml}</div>
      <div class="card-body">
        ${p.category ? `<div class="card-cat">${p.category}</div>` : ''}
        <div class="card-name">${p.name}</div>
        ${p.description ? `<div class="card-desc">${p.description}</div>` : ''}
        <div class="card-price">${settings.currency}${p.price}</div>
        <button class="order-btn" data-order-product="${p.id}">
          Order on WhatsApp
        </button>
      </div>
    `;
    card.querySelector('.order-btn').addEventListener('click', ()=>openOrderModal(p));

    if(imgs.length > 1){
      const imgWrap = card.querySelector('.card-img');
      const slides = imgWrap.querySelectorAll('img');
      const dots = imgWrap.querySelectorAll('.card-img-dots span');
      let current = 0;
      let timer = null;
      function goTo(idx){
        slides[current].classList.remove('active-slide');
        dots[current].classList.remove('active');
        current = (idx + imgs.length) % imgs.length;
        slides[current].classList.add('active-slide');
        dots[current].classList.add('active');
      }
      function startAutoplay(){
        stopAutoplay();
        timer = setInterval(()=>goTo(current+1), 2200);
      }
      function stopAutoplay(){
        if(timer) clearInterval(timer);
      }
      imgWrap.querySelector('.prev').addEventListener('click', (e)=>{ e.stopPropagation(); goTo(current-1); startAutoplay(); });
      imgWrap.querySelector('.next').addEventListener('click', (e)=>{ e.stopPropagation(); goTo(current+1); startAutoplay(); });
      imgWrap.addEventListener('mouseenter', stopAutoplay);
      imgWrap.addEventListener('mouseleave', startAutoplay);
      startAutoplay();
    }

    grid.appendChild(card);
  });
}

/* ---------- Image upload (up to 3 photos) with compression ---------- */
const MAX_PHOTOS = 3;
let pendingImages = [];

function renderUploadRow(){
  const row = document.getElementById('uploadRow');
  row.innerHTML = '';
  pendingImages.forEach((src, idx)=>{
    const slot = document.createElement('div');
    slot.className = 'upload-slot';
    slot.innerHTML = `<img src="${src}"><div class="slot-remove" data-idx="${idx}">✕</div>`;
    row.appendChild(slot);
  });
  if(pendingImages.length < MAX_PHOTOS){
    const addSlot = document.createElement('div');
    addSlot.className = 'upload-slot add-slot';
    addSlot.textContent = '+ Add photo';
    addSlot.addEventListener('click', ()=>document.getElementById('imgInput').click());
    row.appendChild(addSlot);
  }
  row.querySelectorAll('.slot-remove').forEach(btn=>{
    btn.addEventListener('click', (e)=>{
      e.stopPropagation();
      pendingImages.splice(Number(btn.dataset.idx), 1);
      renderUploadRow();
    });
  });
}

function compressAndAdd(file){
  return new Promise((resolve)=>{
    const reader = new FileReader();
    reader.onload = (ev)=>{
      const img = new Image();
      img.onload = ()=>{
        const maxW = 600;
        const scale = Math.min(1, maxW / img.width);
        const canvas = document.createElement('canvas');
        canvas.width = img.width * scale;
        canvas.height = img.height * scale;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        resolve(canvas.toDataURL('image/jpeg', 0.75));
      };
      img.src = ev.target.result;
    };
    reader.readAsDataURL(file);
  });
}

document.getElementById('imgInput').addEventListener('change', async (e)=>{
  const files = Array.from(e.target.files).slice(0, MAX_PHOTOS - pendingImages.length);
  for(const file of files){
    const dataUrl = await compressAndAdd(file);
    pendingImages.push(dataUrl);
  }
  renderUploadRow();
  e.target.value = '';
});

document.getElementById('addUrlBtn').addEventListener('click', ()=>{
  const val = document.getElementById('imgUrlInput').value.trim();
  if(!val) return;
  if(pendingImages.length >= MAX_PHOTOS){
    showToast(`You can add up to ${MAX_PHOTOS} photos`);
    return;
  }
  pendingImages.push(val);
  document.getElementById('imgUrlInput').value = '';
  renderUploadRow();
});

document.getElementById('saveProduct').addEventListener('click', async ()=>{
  const name = document.getElementById('pName').value.trim();
  const price = document.getElementById('pPrice').value.trim();
  const category = document.getElementById('pCategory').value.trim();
  const description = document.getElementById('pDesc').value.trim();

  if(!name || !price){
    showToast('Please enter an item name and price');
    return;
  }

  products.push({
    id: 'p_' + Date.now(),
    name, price, category, description,
    images: pendingImages.slice()
  });

  const ok = await saveProducts();
  if(ok){
    showToast('Product added ✓');
    document.getElementById('pName').value = '';
    document.getElementById('pPrice').value = '';
    document.getElementById('pCategory').value = '';
    document.getElementById('pDesc').value = '';
    document.getElementById('imgUrlInput').value = '';
    document.getElementById('imgInput').value = '';
    pendingImages = [];
    renderUploadRow();
    renderFilters();
    renderProducts();
    renderExistingList();
    renderCategoryDatalist();
  }
});

function renderExistingList(){
  const wrap = document.getElementById('existingList');
  wrap.innerHTML = '';
  if(products.length === 0){
    wrap.innerHTML = '<p class="hint">No products added yet.</p>';
    return;
  }
  products.forEach(p=>{
    const imgs = (p.images && p.images.length) ? p.images : (p.image ? [p.image] : []);
    const row = document.createElement('div');
    row.className = 'existing-item';
    row.innerHTML = `
      <img src="${imgs[0] || ''}" alt="">
      <div class="ei-info">
        <div class="ei-name">${p.name}</div>
        <div class="ei-price">${settings.currency}${p.price} ${p.category ? '· ' + p.category : ''} ${imgs.length ? `· ${imgs.length} photo${imgs.length>1?'s':''}` : ''}</div>
      </div>
      <div class="ei-actions">
        <button data-del="${p.id}" title="Delete">🗑</button>
      </div>
    `;
    wrap.appendChild(row);
  });
  wrap.querySelectorAll('[data-del]').forEach(btn=>{
    btn.addEventListener('click', async ()=>{
      products = products.filter(p=>p.id !== btn.dataset.del);
      const ok = await saveProducts();
      if(ok){
        showToast('Product deleted');
        renderFilters(); renderProducts(); renderExistingList(); renderCategoryDatalist();
      }
    });
  });
}

(async function init(){
  renderUploadRow();
  await loadSettings();
  await loadProducts();
})();
</script>
